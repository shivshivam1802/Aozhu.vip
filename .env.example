# Neon Postgres. Either value is enough. Pooled is preferred when both are set.
DATABASE_URL=
DATABASE_URL_POOLED=

# Session signing. Leave blank locally to use the built-in development fallback.
JWT_SECRET=

# TRON wallet shown on the register screen and checked when a payment is verified.
NEXT_PUBLIC_PAYMENT_WALLET_ADDRESS=
PAYMENT_WALLET_ADDRESS=

# Optional payment checks. These defaults match the current app.
PAYMENT_TOKEN_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
PAYMENT_REQUIRED_USDT=10
TRONGRID_API_URL=https://api.trongrid.io
TRONGRID_API_KEY=

# Studio login. Signup is disabled. Set these in .env, not in source.
DEMO_EMAIL=
DEMO_PASSWORD=
DEMO_NAME=
